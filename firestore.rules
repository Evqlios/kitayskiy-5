// Правила Firestore проекта kitayskiy-5 — версия для site62 (публикуется в консоли вручную).
// Публикация: консоль Firebase → Firestore Database → Rules → вставить весь файл → Publish. Сам файл в Firebase не загружается.
//
// Код группы больше не нужен: рейтинг общий. Вход: Google или гостевой (в консоли Firebase → Authentication → Sign-in method должен быть включён «Anonymous»).
//
// Что защищают правила: чужие данные (прогресс и строка рейтинга пишутся только владельцем), формат и потолки значений,
// закрытый reports, рост минут за неделю не быстрее часов сервера.
// Чего правила НЕ могут: доказать, что цифры честные. Минуты за неделю ограничены «6 часов + реальное время с первой записи недели»,
// но «набить» время в открытой вкладке можно. Ответы на задания лежат в самой странице — подсмотреть их нельзя запретить без сервера.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Прогресс человека: читает и пишет только владелец; удалять нельзя; только поля ts и data.
    // data — строка длиннее 2 и короче 500 000 знаков. Разобрать JSON правила не умеют (проверка «начинается с {» через срезы строк
    // не подтверждена без эмулятора, поэтому не включена): содержимое чистит сам сайт при загрузке (cleanState).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ts', 'data'])
        && request.resource.data.ts is number
        && request.resource.data.data is string
        && request.resource.data.data.size() > 2
        && request.resource.data.data.size() < 500000;
      allow delete: if false;
    }

    // Общий рейтинг: leaders/{uid}. Читает любой, у кого есть вход (Google или гостевой/анонимный). Создаёт, меняет и удаляет ТОЛЬКО владелец своей строки.
    // Поля: n — ник 2–20; w — ключ недели ГГГГ-ММ-ДД; s — секунды за неделю ≤ 360000; k — серия ≤ 1000; m — слов ≤ 300; l — уроков 0–15;
    // p — топиков 0–5; t — время клиента (число); b — время СЕРВЕРА первой записи недели (клиент шлёт REQUEST_TIME; внутри недели менять нельзя).
    // Защита по времени: s ≤ 21600 (6 ч «в подарок») + секунды, прошедшие на сервере с b, + запас 120 с на сеть и округления.
    //   Пример: строка создана 2 ч назад (7200 с) → s ≤ 21600 + 7200 + 120 = 28920 (8 ч 2 мин).
    // Запас считается ОДИН раз за неделю, а не за каждую запись: частые записи ничего не добавляют.
    // Старые строки (до site62) без поля b тоже можно обновить: тогда клиент пишет новое b = время сервера.
    // Честно: гостевой вход бесплатный, поэтому кто-то может завести много гостей. Каждый гость ограничен тем же потолком времени.
    match /leaders/{uid} {
      function shapeOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['n', 'w', 's', 'k', 'm', 't', 'l', 'p', 'b'])
          && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
          && d.w is string && d.w.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.s is int && d.s >= 0 && d.s <= 360000
          && d.k is int && d.k >= 0 && d.k <= 1000
          && d.m is int && d.m >= 0 && d.m <= 300
          && d.t is int && d.t >= 0
          && d.l is int && d.l >= 0 && d.l <= 15
          && d.p is int && d.p >= 0 && d.p <= 5
          && d.b is timestamp
          && d.s * 1000 <= 21600000 + request.time.toMillis() - d.b.toMillis() + 120000;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && shapeOk()
        && request.resource.data.b == request.time;
      allow update: if request.auth != null && request.auth.uid == uid && shapeOk()
        && (
          (request.resource.data.w != resource.data.w && request.resource.data.b == request.time)
          || (resource.data.get('b', null) == null && request.resource.data.b == request.time)
          || (request.resource.data.w == resource.data.w && request.resource.data.b == resource.data.b)
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Статистика заданий (анонимно): taskstats/{id задания: gr01, pn01, g001 — как в клиенте, других id нельзя, чтобы не плодить мусорные документы}; поля a — ответов, c — верных. Без uid и без ников.
    // Читать может любой вошедший. Писать — любой вошедший, но только ПРИБАВЛЯТЬ: за одну запись не больше 50 ответов,
    // верных не больше ответов. Удалять и уменьшать нельзя. Защита от накрутки здесь слабая (анонимность и накрутка несовместимы),
    // поэтому цифры — ориентир для автора, а не оценка людей.
    match /taskstats/{tid} {
      function statOk() {
        let d = request.resource.data;
        return tid.matches('(gr[0-9]{2}|pn[0-9]{2}|g[0-9]{3})') && d.keys().hasOnly(['a', 'c']) && d.a is int && d.c is int && d.c >= 0 && d.c <= d.a;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && statOk() && request.resource.data.a <= 50;
      allow update: if request.auth != null && statOk()
        && request.resource.data.a - resource.data.a >= 0 && request.resource.data.a - resource.data.a <= 50
        && request.resource.data.c - resource.data.c >= 0 && request.resource.data.c - resource.data.c <= request.resource.data.a - resource.data.a;
      allow delete: if false;
    }

    // «Нашёл ошибку»: документ reports/{uid}_{id}_{тип}; читать из сайта нельзя (только в консоли), удалять нельзя.
    // Поля: i — id задания, t — тип, c — текст ≤ 200, d — время (число), n — имя ≤ 40.
    match /reports/{rid} {
      allow read: if false;
      allow create, update: if request.auth != null && rid.size() <= 120 && rid.matches(request.auth.uid + '_[A-Za-z0-9_-]{1,90}')
        && request.resource.data.keys().hasOnly(['i', 't', 'c', 'd', 'n'])
        && request.resource.data.i is string && request.resource.data.i.size() <= 40
        && request.resource.data.t is string && request.resource.data.t.size() <= 40
        && request.resource.data.c is string && request.resource.data.c.size() <= 200
        && request.resource.data.d is int
        && request.resource.data.n is string && request.resource.data.n.size() <= 40;
      allow delete: if false;
    }

    // Всё остальное закрыто (в том числе пробные коллекции groups и groupcodes: их можно удалить в консоли).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
