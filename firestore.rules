// Правила Firestore проекта kitayskiy-5 — версия для site62 (НЕ опубликована: публикуется в консоли вручную).
// Публикация: консоль Firebase → Firestore Database → Rules → вставить весь файл → Publish. Сам файл в Firebase не загружается.
//
// ПЕРЕД публикацией, один раз, в консоли (Firestore Database → Data) создать документ-пропуск для группы:
//   коллекция  groupcodes,  ID документа = КОД ГРУППЫ (8–12 знаков, только A–Z и 0–9, например K7M4Q9XT), любое поле, например name = "ПГПУ".
// Без этого документа в рейтинг не войти. Сменить код = создать новый документ и удалить старый (старые участники перестанут видеть рейтинг).
//
// Что защищают правила: чужие данные (прогресс и строка рейтинга пишутся только владельцем), формат и потолки значений,
// закрытый reports, вход в рейтинг только по коду группы, рост минут за неделю не быстрее часов сервера.
// Чего правила НЕ могут: доказать, что цифры честные. Секунды растут не быстрее реального времени, но «набить» время в открытой вкладке
// можно. Ответы на задания лежат в самой странице — подсмотреть их нельзя запретить без сервера.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Прогресс человека: читает и пишет только владелец; удалять нельзя; только поля ts и data.
    // data — строка до 500 000 знаков, похожая на JSON-объект (начинается с «{», кончается «}»). Разобрать JSON правила не умеют:
    // содержимое дополнительно чистит сам сайт при загрузке (cleanState).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ts', 'data'])
        && request.resource.data.ts is number
        && request.resource.data.data is string
        && request.resource.data.data.size() > 2
        && request.resource.data.data.size() < 500000
        && request.resource.data.data[0:1] == '{'
        && request.resource.data.data[request.resource.data.data.size() - 1:request.resource.data.data.size()] == '}';
      allow delete: if false;
    }

    // Пропуска групп: только консоль (клиенту не читать и не писать). Правила ниже проверяют их наличие через exists().
    match /groupcodes/{code} {
      allow read, write: if false;
    }

    // Рейтинг группы: groups/{КОД}/leaders/{uid}. Читает любой вошедший, КОГДА такой КОД есть в groupcodes.
    // Создаёт, меняет и удаляет ТОЛЬКО владелец своей строки.
    // Поля: n — ник 2–20; g — тот же код; w — ключ недели ГГГГ-ММ-ДД; s — секунды за неделю ≤ 360000; k — серия ≤ 1000;
    // m — слов ≤ 150; l — уроков 0–10; p — топиков 0–5; t — время клиента (число); u — время СЕРВЕРА (клиент шлёт REQUEST_TIME).
    // Защита по времени для s:
    //   • первая запись строки или первая запись новой недели: s ≤ 21600 (6 часов);
    //   • обычная запись: s растёт не больше, чем прошло секунд на сервере с прошлой записи, плюс запас 120 с.
    //     Проверка в миллисекундах: (s_новое − s_старое − 120) × 1000 ≤ (request.time − u_старое).
    //   Пример: прошлая запись была 90 с назад, s было 1000 → s_новое ≤ 1000 + 90 + 120 = 1210.
    // Удалить строку и создать заново нельзя использовать для обхода: создание ограничено теми же 21600 с.
    match /groups/{code}/leaders/{uid} {
      function codeOk() { return code.matches('[A-Z0-9]{6,32}') && exists(/databases/$(database)/documents/groupcodes/$(code)); }
      function shapeOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['n', 'g', 'w', 's', 'k', 'm', 't', 'l', 'p', 'u'])
          && d.n is string && d.n.size() >= 2 && d.n.size() <= 20
          && d.g == code
          && d.w is string && d.w.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.s is int && d.s >= 0 && d.s <= 360000
          && d.k is int && d.k >= 0 && d.k <= 1000
          && d.m is int && d.m >= 0 && d.m <= 150
          && d.t is int && d.t >= 0
          && d.l is int && d.l >= 0 && d.l <= 10
          && d.p is int && d.p >= 0 && d.p <= 5
          && d.u is timestamp && d.u == request.time;
      }
      allow read: if request.auth != null && codeOk();
      allow create: if request.auth != null && request.auth.uid == uid && codeOk() && shapeOk()
        && request.resource.data.s <= 21600;
      allow update: if request.auth != null && request.auth.uid == uid && codeOk() && shapeOk()
        && (
          request.resource.data.s <= 21600 && (request.resource.data.w != resource.data.w || resource.data.get('u', null) == null)
          || resource.data.get('u', null) != null && request.resource.data.w == resource.data.w
             && (request.resource.data.s - resource.data.s - 120) * 1000 <= request.time.toMillis() - resource.data.u.toMillis()
        );
      allow delete: if request.auth != null && request.auth.uid == uid && codeOk();
    }

    // Статистика заданий (анонимно): taskstats/{id задания}; поля a — ответов, c — верных. Без uid и без ников.
    // Читать может любой вошедший. Писать — любой вошедший, но только ПРИБАВЛЯТЬ: за одну запись не больше 50 ответов,
    // верных не больше ответов. Удалять и уменьшать нельзя. Защита от накрутки здесь слабая (анонимность и накрутка несовместимы),
    // поэтому цифры — ориентир для автора, а не оценка людей.
    match /taskstats/{tid} {
      function statOk() {
        let d = request.resource.data;
        return tid.matches('[A-Za-z0-9_-]{1,40}') && d.keys().hasOnly(['a', 'c']) && d.a is int && d.c is int && d.c >= 0 && d.c <= d.a;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && statOk() && request.resource.data.a <= 50;
      allow update: if request.auth != null && statOk()
        && request.resource.data.a - resource.data.a >= 0 && request.resource.data.a - resource.data.a <= 50
        && request.resource.data.c - resource.data.c >= 0 && request.resource.data.c - resource.data.c <= request.resource.data.a - resource.data.a;
      allow delete: if false;
    }

    // «Нашёл ошибку»: документ reports/{uid}_{id}_{тип}; читать из сайта нельзя (только в консоли), удалять нельзя.
    // Поля: i — id задания, t — тип, c — текст ≤ 200, d — время (число), n — имя ≤ 40.
    match /reports/{rid} {
      allow read: if false;
      allow create, update: if request.auth != null && rid.size() <= 120 && rid.matches(request.auth.uid + '_[A-Za-z0-9_-]{1,90}')
        && request.resource.data.keys().hasOnly(['i', 't', 'c', 'd', 'n'])
        && request.resource.data.i is string && request.resource.data.i.size() <= 40
        && request.resource.data.t is string && request.resource.data.t.size() <= 40
        && request.resource.data.c is string && request.resource.data.c.size() <= 200
        && request.resource.data.d is int
        && request.resource.data.n is string && request.resource.data.n.size() <= 40;
      allow delete: if false;
    }

    // Всё остальное закрыто (в том числе старая коллекция leaders/{uid}: после перехода на site62 её можно удалить в консоли).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
